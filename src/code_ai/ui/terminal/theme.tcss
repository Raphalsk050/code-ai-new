Screen {
  background: #071018;
  color: #d7dee8;
}

#root {
  height: 100%;
}

#topbar {
  height: 12;
  border: solid #8892a0;
  padding: 0 1;
}

#logo {
  color: #ff9f1c;
  text-style: bold;
}

#subtitle {
  color: #9aa4b2;
}

#statusline {
  color: #48d17a;
}

#context-meter {
  height: 1;
  color: #d7dee8;
}

#main {
  height: 1fr;
}

#session {
  width: 34%;
  min-width: 28;
  max-width: 58;
  border: solid #8892a0;
  padding: 1;
}

#session-header {
  height: 1;
  width: 1fr;
}

#session-title {
  width: 1fr;
}

.collapse-btn {
  width: 3;
  min-width: 3;
  height: 1;
  border: none;
  padding: 0;
  color: #ff9f1c;
  background: transparent;
}

.collapse-btn:hover {
  background: #1b2530;
}

/* Collapsed: shrink to a thin strip showing only the expand button. */
#session.collapsed {
  width: 5;
  min-width: 5;
  max-width: 5;
  padding: 1 0;
}

#session.collapsed #session-title {
  display: none;
}

#session.collapsed #session-info {
  display: none;
}

#conversation-pane {
  width: 1fr;
  border: solid #8892a0;
  padding: 1;
}

#conversation {
  width: 1fr;
  height: 1fr;
  padding: 0;
}

#stream-tail {
  height: auto;
  max-height: 16;
  color: #d7dee8;
}

#plan {
  width: 38;
  min-width: 30;
  border: solid #8892a0;
  padding: 1;
}

#plan-body {
  height: 1fr;
}

#working-indicator {
  height: 1;
  padding: 0 1;
}

#command-suggestions {
  height: auto;
  max-height: 10;
  border: solid #8892a0;
  color: #d7dee8;
  background: #111820;
  padding: 0 1;
}

#input-row {
  height: 3;
}

#mode-select {
  width: 24;
  margin-right: 1;
}

#mode-select > SelectCurrent {
  border: solid #ff9f1c;
}

#input {
  width: 1fr;
  height: 3;
  border: solid #8892a0;
}

.panel-title {
  color: #ff9f1c;
  text-style: bold;
}

ApprovalModal {
  align: center middle;
}

#approval-dialog {
  width: 85%;
  max-width: 110;
  height: auto;
  max-height: 90%;
  border: thick #ff9f1c;
  background: #111820;
  padding: 1 2;
}

#approval-title {
  color: #ff9f1c;
  text-style: bold;
  padding-bottom: 1;
}

#approval-meta {
  color: #9fb3c8;
  padding-bottom: 1;
}

/* Code preview: grows with the content but caps out and scrolls (both axes)
   when the file is taller/wider than the available room. */
#approval-body {
  height: auto;
  max-height: 1fr;
  overflow: auto auto;
  scrollbar-size: 1 1;
  background: #111820;
}

#approval-code {
  width: auto;
  height: auto;
}

#approval-info {
  color: #9fb3c8;
  padding-top: 1;
}

#approval-keys {
  color: #d7dee8;
  padding-top: 1;
  padding-bottom: 1;
}

#approval-actions {
  height: auto;
  align-horizontal: center;
}

#approval-actions Button {
  margin: 0 1;
}
