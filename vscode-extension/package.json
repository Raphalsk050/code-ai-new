{
  "name": "code-ai",
  "displayName": "Code-AI",
  "description": "Drive the Code-AI agent from VSCode. Ships the agent with it: no Python, no install.",
  "version": "0.48.6",
  "publisher": "code-ai",
  "private": true,
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:code-ai.chat",
    "onWebviewPanel:code-ai.window",
    "onCustomEditor:code-ai.flow"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "code-ai",
          "title": "Code-AI",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "code-ai": [
        {
          "id": "code-ai.chat",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "code-ai.flow",
        "displayName": "Code-AI Orchestrator",
        "selector": [
          {
            "filenamePattern": "*.flow.json"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "code-ai.open",
        "title": "Code-AI: Focus Chat"
      },
      {
        "command": "code-ai.popOut",
        "title": "Code-AI: Open Chat in a New Window",
        "icon": "$(link-external)"
      },
      {
        "command": "code-ai.restart",
        "title": "Code-AI: Restart (reload settings)",
        "icon": "$(refresh)"
      },
      {
        "command": "code-ai.toggleInlineHints",
        "title": "Code-AI: Toggle Inline Hints"
      },
      {
        "command": "code-ai.inlineHintInfo",
        "title": "Code-AI: Inline Hint Source"
      },
      {
        "command": "code-ai.testInlineHint",
        "title": "Code-AI: Test Inline Hint at Cursor"
      },
      {
        "command": "code-ai.newFlow",
        "title": "Code-AI: New Orchestrator Graph"
      },
      {
        "command": "code-ai.runFlow",
        "title": "Code-AI: Run Graph",
        "icon": "$(play)"
      },
      {
        "command": "code-ai.stopFlow",
        "title": "Code-AI: Stop Graph",
        "icon": "$(debug-stop)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "code-ai.popOut",
          "when": "view == code-ai.chat",
          "group": "navigation"
        },
        {
          "command": "code-ai.restart",
          "when": "view == code-ai.chat",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Code-AI",
      "properties": {
        "code-ai.command": {
          "type": "string",
          "default": "code-ai",
          "description": "Executable that launches the agent. The extension appends the `bridge` subcommand."
        },
        "code-ai.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments inserted before `bridge` (e.g. [\"--config\", \"/path/config.json\"])."
        },
        "code-ai.diff.openInEditor": {
          "type": "boolean",
          "default": true,
          "description": "Show the agent's file edits in the editor's diff view as they are written, instead of inside the Code-AI panel."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "avatar-lab": "node scripts/avatar-lab.mjs",
    "desktop-avatar": "node scripts/desktop-avatar.mjs",
    "typecheck": "tsc --noEmit",
    "package": "node scripts/package.mjs",
    "verify-vsix": "node scripts/verify-vsix.mjs",
    "test:webview": "node scripts/test-webview.mjs",
    "test:package": "node scripts/test-package.mjs",
    "test:e2e": "node e2e/run.mjs",
    "test": "npm run typecheck && npm run lint:i18n && npm run test:webview && npm run test:package && npm run test:e2e",
    "lint:i18n": "node scripts/check-i18n.mjs"
  },
  "devDependencies": {
    "@types/diff": "^5.0.9",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.20.0",
    "playwright": "^1.56.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24",
    "diff": "^5.2.0",
    "dompurify": "^3.0.11",
    "highlight.js": "^11.9.0",
    "katex": "^0.16.47",
    "marked": "^12.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
