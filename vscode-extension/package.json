{
  "name": "code-ai",
  "displayName": "Code-AI",
  "description": "Drive the Code-AI agent from VSCode (skeleton: spawns the stdio JSON-RPC bridge).",
  "version": "0.0.3",
  "publisher": "code-ai",
  "private": true,
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:code-ai.chat"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "code-ai",
          "title": "Code-AI",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "code-ai": [
        {
          "id": "code-ai.chat",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "code-ai.open",
        "title": "Code-AI: Focus Chat"
      }
    ],
    "configuration": {
      "title": "Code-AI",
      "properties": {
        "code-ai.command": {
          "type": "string",
          "default": "code-ai",
          "description": "Executable that launches the agent. The extension appends the `bridge` subcommand."
        },
        "code-ai.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments inserted before `bridge` (e.g. [\"--config\", \"/path/config.json\"])."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "node esbuild.mjs && npx --yes @vscode/vsce package --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/diff": "^5.0.9",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/vscode": "^1.74.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "diff": "^5.2.0",
    "dompurify": "^3.0.11",
    "highlight.js": "^11.9.0",
    "marked": "^12.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
