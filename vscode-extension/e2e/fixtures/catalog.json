  "professions": [
    {
      "name": "architect",
      "title": "Architect",
      "description": "Software architect. Reads the codebase and designs: boundaries, data flow, trade-offs, the order the work should happen in. Never edits files - it hands back a design the writers implement.",
      "writes": false,
      "runs_processes": false,
      "read_only": true,
      "max_model_steps": 30,
      "capabilities": [
        "local_read",
        "web"
      ]
    },
    {
      "name": "code_writer",
      "title": "Code Writer",
      "description": "Implementation worker. Carries out one focused, self-contained change: reads what it needs, edits or creates files, and runs commands to verify.",
      "writes": true,
      "runs_processes": true,
      "read_only": false,
      "max_model_steps": 60,
      "capabilities": [
        "local_read",
        "local_write",
        "process",
        "web"
      ]
    },
    {
      "name": "documenter",
      "title": "Documenter",
      "description": "Documentation writer. Reads code and writes the docs that explain it - docstrings, README sections, API references. Edits files but runs nothing.",
      "writes": true,
      "runs_processes": false,
      "read_only": false,
      "max_model_steps": 40,
      "capabilities": [
        "local_read",
        "local_write",
        "web"
      ]
    },
    {
      "name": "wiki_writer",
      "title": "Wiki Writer",
      "description": "Long-form writer. Produces the prose that lives outside the code: guides, architecture notes, onboarding pages, changelog entries.",
      "writes": true,
      "runs_processes": false,
      "read_only": false,
      "max_model_steps": 40,
      "capabilities": [
        "local_read",
        "local_write",
        "web"
      ]
    },
    {
      "name": "ui_designer",
      "title": "Ui Designer",
      "description": "Interface designer. Builds and refines the user-facing surface: layout, states, spacing, contrast, responsiveness. Edits markup and styles.",
      "writes": true,
      "runs_processes": false,
      "read_only": false,
      "max_model_steps": 50,
      "capabilities": [
        "local_read",
        "local_write",
        "web"
      ]
    },
    {
      "name": "teacher",
      "title": "Teacher",
      "description": "Explainer. Reads the code and teaches it: what it does, why it is built that way, what to watch out for. Never edits anything.",
      "writes": false,
      "runs_processes": false,
      "read_only": true,
      "max_model_steps": 30,
      "capabilities": [
        "local_read",
        "web"
      ]
    },
    {
      "name": "tester",
      "title": "Tester",
      "description": "Test writer. Adds the tests a change needs and runs them, reporting what passes and what it could not cover.",
      "writes": true,
      "runs_processes": true,
      "read_only": false,
      "max_model_steps": 50,
      "capabilities": [
        "local_read",
        "local_write",
        "process",
        "review"
      ]
    },
    {
      "name": "coder",
      "title": "Coder",
      "description": "Implementation worker. Carries out ONE focused, self-contained change: reads what it needs, edits or creates files, and runs commands to verify. Give it a precise, bounded task with clear acceptance criteria. Not for open-ended planning or work that spans many unrelated areas.",
      "writes": true,
      "runs_processes": true,
      "read_only": false,
      "max_model_steps": 60,
      "capabilities": [
        "local_read",
        "local_write",
        "process",
        "web"
      ]
    },
    {
      "name": "explorer",
      "title": "Explorer",
      "description": "Read-only investigator. Searches and reads the workspace (and the web) to answer a focused question - locating code, tracing behavior, gathering facts. Cannot modify files or run processes. Use it to fan out research in parallel before you plan or change anything.",
      "writes": false,
      "runs_processes": false,
      "read_only": true,
      "max_model_steps": 30,
      "capabilities": [
        "local_read",
        "web"
      ]
    },
    {
      "name": "reviewer",
      "title": "Reviewer",
      "description": "Code reviewer. Reads code and diffs and runs the review/build/test tools to judge quality, correctness, and risk, then reports findings. Read-only with respect to source: it never edits files. Use it to get an independent assessment of a change or an area of the codebase.",
      "writes": false,
      "runs_processes": true,
      "read_only": false,
      "max_model_steps": 30,
      "capabilities": [
        "local_read",
        "process",
        "review",
        "web"
      ]
    }
