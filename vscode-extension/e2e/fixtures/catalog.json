  "professions": [
    {
      "name": "agent",
      "title": "Agent",
      "description": "Plain agent, no specialism. Reads, edits, runs commands and searches the web - the whole toolbox, pointed at whatever the task says. Reach for it when no profession below is the obvious fit.",
      "writes": true,
      "runs_processes": true,
      "read_only": false,
      "max_model_steps": 50,
      "capabilities": [
        "local_read",
        "local_write",
        "process",
        "web"
      ]
    },
    {
      "name": "architect",
      "title": "Architect",
      "description": "Software architect. Reads the codebase and designs: boundaries, data flow, trade-offs, the order the work should happen in. Never edits files - it hands back a design the writers implement.",
      "writes": false,
      "runs_processes": false,
      "read_only": true,
      "max_model_steps": 30,
      "capabilities": [
        "local_read",
        "web"
      ]
    },
    {
      "name": "code_writer",
